# Environment variables

# Stripe publishable key (set in Vercel or .env.local)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe secret key (server)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (from stripe listen or dashboard)
STRIPE_WEBHOOK_SECRET=

# Return URL after Financial Connections completes
NEXT_PUBLIC_RETURN_URL=http://localhost:3000/success

# (Optional) Price ID to use for recurring subscriptions (create a Price in your Stripe Dashboard)
STRIPE_PRICE_ID=

# (Optional) Expose price on the client for convenience
NEXT_PUBLIC_STRIPE_PRICE_ID=

# SendGrid configuration for custom receipts
SENDGRID_API_KEY=
EMAIL_FROM=
